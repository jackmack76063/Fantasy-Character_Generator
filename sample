void processMovieFile(char* filePath){
    int pSize = 0;
    char *line = NULL;
    int lineTrack = 0;
    size_t len = 0;
    size_t line_count = 0;
    char *currLine = NULL; 
    char *endptr = NULL;
    Record* head = NULL;
    
    // Getting file line amount
    FILE *movieFile = fopen(filePath, "r");

    while(getline(&line, &len, movieFile) != -1)
    {
    //printf("%s", currLine);
    line_count++;
    }
    line_count--;
    pSize = line_count;
    // Free the memory allocated by getline for currLine
    free(line);
    // Close the file
    fclose(movieFile);
    
    printf("Now processing the chosen file named %s\n" , filePath);
    

    //Processing file into our struct.  
     //Open the file to read the data and store it in our struct
    movieFile = fopen(filePath, "r");
        // Read the file line by line
         // Read the file line by line
    
    while(getline(&currLine, &len, movieFile) != -1)
    {  

        if(lineTrack == 0){
                lineTrack++;
                continue;
        }  
        //1st token is our title
        Record* tempP = (Record *) malloc(sizeof(Record));
        char* token = strtok(currLine, ",");
        //store the length of our token in size, to dynamically allocate
        tempP->title = calloc(strlen(token) + 1, sizeof(char)); 
        if (tempP->title != NULL) {
            strcpy(tempP->title, token);     
        }
        //2nd token is our year
        token = strtok(NULL, ",");
        tempP->year = atoi(token);
        //3rd token is our languages
        token = strtok(NULL, ",");
        tempP->languages = calloc(strlen(token) + 1, sizeof(char)); 
        if (tempP->languages != NULL) {
            strcpy(tempP->languages, token);       
        }
        //4th token is our rating
        token = strtok(NULL, ",");
        tempP->rating = strtof(token, &endptr);  
        tempP->next = NULL;

        if (head == NULL){
            head = tempP;
        }
        else{
            Record* current = head;
            while (current->next != NULL){
                current = current->next;
            }
            current->next = tempP;
        }     
    }
     // Free the memory allocated by getline for currLine
    free(currLine);
    // Close the file
    fclose(movieFile);
    makeDirectory(head, filePath);
    free(head);
}

void makeDirectory(Record * p, char* filePath){
    char newDir[30];
    char *newPath = malloc(256 * sizeof(char));
    int randomNum = 0;
    int file_descriptor;
    int year = 0;
    int howMany = 0;
    char newMessage[256];
    Record *tempP = p;
    srand(time(NULL));
    randomNum = (rand() % (99999 - 0 + 1)) + 0;
    sprintf(newDir, "jackmack.movies.%d", randomNum);

    //create directory to store files
     if (mkdir(newDir, 0750) == -1) {

        perror("Error creating directory");

        return;
    }
    printf("Created directory with name %s\n", newDir);
    tempP = p;
    while (tempP != NULL){
        //combine directory and needed file name to create a path
        sprintf(newPath, "%s/%d.txt", newDir, tempP->year);
        //create file if it doesn't exist, and append for writing
        file_descriptor = open(newPath, O_WRONLY | O_CREAT | O_APPEND, 0640);

        //check if error
        if (chmod(newPath, 0640) == -1){
            printf("open() failed on \"%s\"\n", newPath);
            perror("Error");
            exit(1);
        }
        //write movie into it
        //sprintf(newMessage, "%s\n", tempP->title);
        strcpy(newMessage, tempP->title);
        howMany = write(file_descriptor, newMessage, strlen(newMessage));
        write(file_descriptor, "\n", 1);
        close(file_descriptor);
        tempP = tempP->next;
    }
    free(tempP);
    free(newPath);
}
